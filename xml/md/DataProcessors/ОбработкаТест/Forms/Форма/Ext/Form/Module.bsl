// Форма обработки для запуска тестовых сценариев
// Используется для генерации эталонного PFF замера

&НаСервере
Процедура ТестНаСервере()
	// Серверная процедура, вызываемая с клиента
	// Проверка контекста: должна быть помечена как "Обработка сервером"
	
	Сообщить("Выполняется ТестНаСервере");
	
	// Вызов серверного модуля
	Сервер.ВыполнитьСерверныйКод();
	
	// Тест транзакции
	Сервер.ТестТранзакции();
	
	// Тест обработки исключений
	Попытка
		Сервер._ВызватьИсключение();
	Исключение
		Сообщить("Исключение успешно поймано: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура Тест(Команда)
	// Главная тестовая процедура - запускает полный цикл тестов
	
	Сообщить("=== НАЧАЛО ТЕСТА PFF ===");
	
	// 1. Вызов клиентского кода
	Сообщить("1. Тест клиентского модуля");
	Клиент.ВыполнитьКлиентскийКод();
	
	// 2. Вызов общего кода из клиентского контекста
	Сообщить("2. Тест общего модуля (контекст: клиент)");
	КлиентСервер.ОбщийКод();
	
	// 3. Вызов серверного кода через ТестНаСервере
	Сообщить("3. Тест серверного модуля");
	ТестНаСервере();
	
	Сообщить("=== КОНЕЦ ТЕСТА PFF ===");
КонецПроцедуры

&НаКлиенте
Процедура СтартоватьФоновое(Команда)
	// Запуск фонового задания для тестирования контекста фоновых заданий
	
	Сообщить("Запуск фонового задания...");
	
	РезультатЗапуска = СтартоватьФоновоеНаСервере();
	
	Если РезультатЗапуска.Статус = "Выполнено" Тогда
		Сообщить("Фоновое задание успешно запущено: " + РезультатЗапуска.ИдентификаторЗадания);
	Иначе
		Сообщить("Ошибка запуска фонового задания");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция СтартоватьФоновоеНаСервере()
	// Запуск фонового задания на сервере
	
	Результат = Новый Структура;
	Результат.Вставить("Статус", "");
	Результат.Вставить("ИдентификаторЗадания", "");
	
	Попытка
		// Запуск регламентного задания в фоновом режиме
		Задание = ФоновыеЗадания.Выполнить(
			"Сервер.РегламентноеЗадание",
			,
			,
			"Тестовое фоновое задание для PFF");
		
		Результат.Статус = "Выполнено";
		Результат.ИдентификаторЗадания = Строка(Задание.УникальныйИдентификатор);
		
	Исключение
		Результат.Статус = "Ошибка";
		Результат.Вставить("ОписаниеОшибки", ОписаниеОшибки());
	КонецПопытки;
	
	Возврат Результат;
КонецФункции
